{
  "name": "@bank/ui",
  "version": "0.1.0",
  "description": "UI-библиотека «Банка»: дизайн-токены, компоненты, форматирование",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "fonts.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./fonts.css": "./fonts.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && vite build && tsc -p tsconfig.build.json",
    "dev": "npm run clean && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & vite build --watch)",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource/onest": "^5.2.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.0"
  }
}
